{
  "name": "fast-manager-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "F.A.S.T Manager — Finally Awesome and Simple Task Manager",
  "license": "MIT",
  "scripts": {
    "dev": "npm --prefix app run dev",
    "dev:sync": "concurrently \"npm run dev:sync-server\" \"npm run dev:web\"",
    "dev:web": "npm --prefix app run dev",
    "dev:sync-server": "npm --prefix sync-server run dev",
    "build": "npm --prefix app run build",
    "build:windows": "npm --prefix app run tauri:build",
    "tauri:dev": "npm --prefix app run tauri:dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
