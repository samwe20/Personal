#!/usr/bin/env bash
# Projekt je složka. Větev je úkol.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "bez gitu")"

dir_for() {
  case "$1" in
    deniky) echo deniky ;;
    ostatni) echo ostatni ;;
    posta) echo posta ;;
  esac
}

workspace_for() {
  case "$1" in
    deniky) echo Deniky.code-workspace ;;
    ostatni) echo Ostatni.code-workspace ;;
    posta) echo Posta.code-workspace ;;
  esac
}

echo "Personal"
echo "větev: $branch"
case "$branch" in
  main)
    echo "stav: společný main, všechny tři projekty"
    ;;
  feat/*|fix/*)
    echo "stav: rozdělaná změna. Po sloučení do main tu větev smaž."
    ;;
  *)
    echo "stav: tohle není projekt. Je to jiná větev. Projekty jsou složky."
    ;;
esac

normalize() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

if [[ $# -lt 1 ]]; then
  echo
  echo "Projekty:"
  for key in deniky ostatni posta; do
    dir="$(dir_for "$key")"
    name="$(head -n 1 "$ROOT/$dir/PROJECT")"
    printf '  %-8s %s  (%s/)  otevři %s\n' "$key" "$name" "$dir" "$(workspace_for "$key")"
  done
  echo
  echo "Folio a F.A.S.T. Manager jsou v samostatných repozitářích (viz README.md)."
  echo "Otevři workspace soubor. ./project deniky vypíše jen Deníky."
  exit 0
fi

key="$(normalize "$1")"
case "$key" in
  deniky|deníky|diaries) key=deniky ;;
  ostatni|ostatní|other) key=ostatni ;;
  posta|pošta) key=posta ;;
  folio|fast|f.a.s.t|fast-manager)
    echo "Projekt $1 už není v tomto repozitáři. Viz README.md pro odkazy na samostatné repozitáře."
    exit 1
    ;;
  *)
    echo "Neznámý projekt: $1"
    echo "Znám deniky, ostatni, posta."
    exit 1
    ;;
esac

dir="$(dir_for "$key")"
if [[ ! -f "$ROOT/$dir/PROJECT" ]]; then
  echo "Chybí $dir/PROJECT"
  exit 1
fi

echo
echo "projekt: $(head -n 1 "$ROOT/$dir/PROJECT")"
echo "složka: $dir/"
echo "workspace: $(workspace_for "$key")"
